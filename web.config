<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!-- Redirect /ncr-auto-admin ไป /ncr-auto-admin/login -->
        <rule name="RedirectAdminRootToLogin" stopProcessing="true">
          <match url="^ncr-auto-admin/?$" />
          <action type="Redirect" url="/ncr-auto-admin/login" redirectType="Found" />
        </rule>

        <!-- Reverse Proxy: rewrite ไป http://localhost:8080/ncr-auto-admin/{R:1} -->
        <rule name="ReverseProxyInboundRule1" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8080/ncr-auto-admin/{R:1}" />
        </rule>

      </rules>

      <!-- ✅ Outbound rules: เพิ่ม X-Forwarded-Proto -->
      <outboundRules>
        <rule name="Add X-Forwarded-Proto" preCondition="IsHTTPS">
          <match serverVariable="RESPONSE_X-Forwarded-Proto" pattern=".*" />
          <action type="Rewrite" value="https" />
        </rule>
        <preConditions>
          <preCondition name="IsHTTPS">
            <add input="{HTTPS}" pattern="on" />
          </preCondition>
        </preConditions>
      </outboundRules>

    </rewrite>

    <proxy>
      <reverseProxy enabled="true" />
    </proxy>

    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>

  </system.webServer>
</configuration>
